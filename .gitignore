# --- Recovery staging area (raw extracted artifacts, not source of truth) ---
# The verified content has been copied into the repository (ManualSync_1.0_FINAL_CANDIDATE/,
# docs/reports/MANUALSYNC_PREVIOUS_WORK_HANDOFF.md). This folder itself is a temporary
# local staging area and must not be versioned.
_RECOVERY/

# --- ERYLOS desktop build outputs (BUILD_WINDOWS.ps1 writes them next to itself) ---
# Generated by every build, never source. Names are explicit on purpose:
# a broad "BUILD_*" would also match the tracked BUILD_WINDOWS.ps1, and a
# bare "release/" would match any future folder with that name.
.buildvenv/
/ManualSync_1.0_FINAL_CANDIDATE/release/
installer_stage/
build_launcher/
dist_launcher/
setup_zip_probe/
build_reports/
BUILD_STATUS.json
BUILD_FINAL_CANDIDATE_LOG.txt

# --- ERYLOS test / verification outputs written into the source folder ---
# regressione_*.py suites, the environment_guard.py self-test and
# VERIFICA_CICLO_INSTALLAZIONE.ps1 write their reports next to the sources.
RISULTATO_*.json
RUNTIME_SELF_TEST_FINAL.json
RUNTIME_SELF_TEST_FINAL.txt
regressione_*_out/
# Legacy location: before 22/09/2026 the acceptance server log was written here.
.acceptance_server_*.log

# NOTE: do NOT add blanket ignores for docs, sources, tests, fixtures,
# databases, or config files. Anything intended as a versioned fixture
# or reference artifact must be explicitly reviewed before being ignored.
